# ====== Servidor ======
PORT=3101
# Origens do frontend permitidas no CORS, separadas por vírgula (ex.: https://nexo-web.up.railway.app)
WEB_ORIGIN=http://localhost:5173
# development | production (em production o JWT_SECRET é obrigatório)
NODE_ENV=development

# ====== Banco (Postgres) ======
DATABASE_URL=postgres://nexo:nexo@localhost:5442/nexo

# ====== Autenticação (JWT) ======
# Segredo que assina os tokens. Gere um aleatório: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Senha das contas de demonstração (seed). Em dev, vazio = Nexo@2026. Em produção, defina (ou as contas demo não entram).
SEED_PASSWORD=
# Popular os dados de exemplo no primeiro start (true/false)
SEED_ON_START=true
# Conta de administrador (conecta o WhatsApp). Em produção, defina a senha.
ADMIN_EMAIL=admin@nexo.com.br
ADMIN_PASSWORD=

# ====== LLM ======
# Provedor: google (Gemini) ou anthropic (Claude)
LLM_PROVIDER=google
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Vazio = padrão do provedor (google: gemini-3.5-flash · anthropic: claude-haiku-5-5)
AGENT_MODEL=
# Gemini 3.x: nível de "thinking" (low = rápido e barato)
GEMINI_THINKING=low
# Limite de mensagens do funcionário por sessão de conversa
SESSION_MESSAGE_LIMIT=30

# ====== Sistema de chamados legado (simulado) ======
# Probabilidade (0-1) de uma chamada falhar, para exercitar retry/degradação. 0 desliga.
LEGACY_FAILURE_RATE=0

# ====== WhatsApp via Evolution API ======
EVOLUTION_API_URL=http://localhost:8180
EVOLUTION_API_KEY=troque-esta-chave
EVOLUTION_INSTANCE=nexo-assist
# Segredo que a Evolution envia no header x-webhook-secret a cada mensagem
EVOLUTION_WEBHOOK_SECRET=troque-este-segredo
# URL do webhook DESTE backend que a Evolution chama quando chega mensagem no WhatsApp.
# O backend registra essa URL na Evolution sozinho ao subir. Na Railway, pode deixar vazio:
# usa https://$RAILWAY_PUBLIC_DOMAIN/api/whatsapp/webhook automaticamente.
PUBLIC_WEBHOOK_URL=http://host.docker.internal:3101/api/whatsapp/webhook

# Os celulares dos funcionários são vinculados no painel de admin (aba WhatsApp), não no .env.
